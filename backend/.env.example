PORT=5001
# Hostinger sets PORT automatically on Node.js hosting — keep PORT only for local/VPS if needed
HOST=0.0.0.0

# Production (Hostinger): use MongoDB Atlas — shared hosting has no local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/lead-management
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/lead-management?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-secret-key

# Public site URL (HTTPS). Required for CORS when frontend runs separately; also set for same-domain deploy.
# Local dev:
# CLIENT_URL=http://localhost:5173
# Hostinger production example:
# CLIENT_URL=https://yourdomain.com

# Hostinger / production: uncomment to serve React from backend/public/ (after npm run build from project root)
# NODE_ENV=production
# SERVE_FRONTEND=1
# CLIENT_URL=https://yourdomain.com
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change-this-admin-password

# Verified signup payment (Razorpay) — required for new user registration after step 1
# Dashboard: https://dashboard.razorpay.com/ → Settings → API Keys (use Test keys for development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
# Amount in paise (minimum 100 = ₹1). Example ₹99 = 9900
RAZORPAY_AMOUNT_PAISE=100
RAZORPAY_BUSINESS_NAME=Your Business Name
RAZORPAY_DESCRIPTION=New account signup

# Optional: shown in Razorpay checkout if RAZORPAY_BUSINESS_NAME is unset
PAYMENT_MERCHANT_NAME=Your Business Name
