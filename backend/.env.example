PORT=5001
# Listen on all interfaces (required on Hostinger / VPS)
HOST=0.0.0.0

# MongoDB Atlas (recommended for Hostinger)
# Atlas → Network Access: add 0.0.0.0/0 (allow from anywhere) or your server IP
# Atlas → Database → Connect → Drivers → copy connection string, replace <password>
# Encode special characters in password (@ → %40, etc.)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/lead-management?retryWrites=true&w=majority

# Local development only:
# MONGODB_URI=mongodb://127.0.0.1:27017/lead-management

JWT_SECRET=change-this-to-a-long-random-secret-key

# Public site URL (HTTPS). Required for CORS when frontend runs separately; also set for same-domain deploy.
# Local dev:
# CLIENT_URL=http://localhost:5173
# Hostinger production example:
# CLIENT_URL=https://yourdomain.com

# Hostinger / production: uncomment to serve React from backend/public/ (after npm run build from project root)
# NODE_ENV=production
# SERVE_FRONTEND=1
# CLIENT_URL=https://yourdomain.com
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=change-this-admin-password

# Signup payment (Razorpay) — step 3 of Get Started
# Until real keys are set, payment is bypassed automatically (same UI, no charge).
# When ready: add keys below and set RAZORPAY_BYPASS=false
RAZORPAY_BYPASS=true
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret_here
# Amount in paise (minimum 100 = ₹1). Example ₹99 = 9900
RAZORPAY_AMOUNT_PAISE=100
RAZORPAY_BUSINESS_NAME=Your Business Name
RAZORPAY_DESCRIPTION=New account signup

# Optional: shown in Razorpay checkout if RAZORPAY_BUSINESS_NAME is unset
PAYMENT_MERCHANT_NAME=Your Business Name
