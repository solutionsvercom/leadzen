# Dependencies
node_modules/

# Production build → backend/public (generated before Hostinger deploy)
frontend/dist/
backend/public/*
!backend/public/.gitkeep
dist/
build/

# Environment & secrets (set these in Hostinger hPanel / VPS — never commit)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime / uploads (user-uploaded logos)
backend/uploads/*
!backend/uploads/.gitkeep

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / editors
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# Test / coverage
coverage/
.nyc_output/

# Cache & temp
.cache/
.temp/
tmp/
*.tsbuildinfo

# Deploy archives (do not commit bundles you upload manually)
*.zip
deploy.zip
hostinger-deploy.zip

# Optional local PM2
.pm2/
